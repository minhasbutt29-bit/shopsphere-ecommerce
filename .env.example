# ---------- Core ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Database (PostgreSQL / Supabase) ----------
# Supabase: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shopsphere?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/shopsphere?schema=public"

# ---------- Auth.js ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# ---------- Initial admin (used ONLY by `npm run db:seed`) ----------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password-min-12-chars"
SEED_ADMIN_NAME="Store Admin"
# Set to "true" to also create demo customer + demo catalogue
SEED_DEMO_DATA="true"

# ---------- Stripe (test mode) ----------
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ---------- SMTP ----------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"
EMAIL_FROM="ShopSphere <no-reply@example.com>"
